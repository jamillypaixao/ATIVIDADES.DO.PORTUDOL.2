rograma {
  funcao inicio() {
real media

	
		escreva("Digite a média do aluno: ")
		leia(media)

		se (media >= 7.0)
		{
			escreva("Situação: APROVADO\n")
		}
		senao se (media >= 4.0 e media < 7.0)
		{
			escreva("Situação: RECUPERAÇÃO\n")
		}
		senao
		{
			escreva("Situação: REPROVADO\n")
		}

  }
}
